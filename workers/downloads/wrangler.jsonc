{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockholm1646-downloads",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Served at https://stockholm1646-downloads.ratterstudios.workers.dev
  "workers_dev": true,
  // Logs in the Cloudflare dashboard
  "observability": { "enabled": true },
  // Download counter
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "DownloadCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DownloadCounter"] }],
}
